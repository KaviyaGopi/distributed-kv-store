{
  "title": "KV Store Overview",
  "uid": "kv-store-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Raft Leader by Shard",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "raft_state",
          "legendFormat": "{{instance}} shard {{shard}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Follower" },
                "1": { "text": "Candidate" },
                "2": { "text": "Leader" },
                "3": { "text": "Shutdown" }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Leader Changes Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(raft_leader_changes_total[1m])) by (shard)",
          "legendFormat": "shard {{shard}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "KV Request Rate by Op",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(kv_requests_total[1m])) by (op, status)",
          "legendFormat": "{{op}} ({{status}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Commit Latency p99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(kv_request_duration_seconds_bucket[5m])) by (le, op))",
          "legendFormat": "{{op}} p99",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Replication Lag (last_index - applied_index)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "raft_last_index - raft_applied_index",
          "legendFormat": "{{instance}} shard {{shard}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Kafka Publish Success Rate",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(kafka_publish_total{status=\"success\"}[5m])) / clamp_min(sum(rate(kafka_publish_total[5m])), 1e-9)",
          "legendFormat": "success ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      }
    }
  ]
}
